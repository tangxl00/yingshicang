<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>影视仓</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>MainBg</string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 采集站/直播源大量为 HTTP 明文地址，配置中不可枚举域名，故整体放开；
		     这是与原 App 行为对齐的必要条件（原 App 亦全量明文访问）。 -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于发现并连接同一局域网内的电视端影视仓，实现配置下发、播放历史同步、投屏与推送播放；同时用于连接局域网内的 WebDAV/网盘服务与本地媒体服务器。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_dlna._tcp</string>
		<string>_airplay._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>用于扫描二维码添加配置地址、扫描局域网同步目标设备，以及扫码快捷配置。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择本地视频文件播放，以及从相册选取图片设置首页壁纸。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于将下载完成的视频保存到相册。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>部分直播源与弹幕互动需要麦克风权限时使用。</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>用于读取「文件」App 中的本地视频与配置文件，并保存下载的视频。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
